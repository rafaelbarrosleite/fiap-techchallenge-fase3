# Copie para .env. Nunca versione segredos.
# Modelo base do fine-tuning (Llama 3.2 3B Instruct, licença Llama 3.2).
# Cópia pública convertida para MLX/4-bit: baixa sem token do Hugging Face.
BASE_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit
# Alternativa para o notebook Colab (PyTorch/PEFT), também sem token:
# BASE_MODEL=unsloth/Llama-3.2-3B-Instruct
# Token do Hugging Face: opcional, só necessário para o repositório oficial meta-llama/*.
# HF_TOKEN=
# Diretório de logs de auditoria.
AUDIT_LOG_DIR=logs
